            android:process=":gnss_binder_test" />
        <service
            android:name="com.system.location.service.CarrierIdentityProbeService"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":carrier_probe" />
    </application>
</manifest>
