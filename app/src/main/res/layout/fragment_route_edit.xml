<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <EditText android:id="@+id/query" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:hint="搜索地点，再设为起点或终点" android:inputType="text" android:singleLine="true" />
        <Button android:id="@+id/search" android:layout_width="wrap_content" android:layout_height="48dp" android:text="搜索" />
    </LinearLayout>
    <RadioGroup android:id="@+id/endpoint" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <RadioButton android:id="@+id/select_start" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:checked="true" android:text="点击地图设置起点" />
        <RadioButton android:id="@+id/select_end" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="点击地图设置终点" />
    </RadioGroup>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:maxLines="4" />
    <com.amap.api.maps.MapView android:id="@+id/amap_view" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/plan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="规划 / 重新规划" />
        <Button android:id="@+id/cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="取消路线" />
        <Button android:id="@+id/confirm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="确认路线" />
    </LinearLayout>
</LinearLayout>
