<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <Spinner android:id="@+id/library_kind" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="资料库类型" />
    <TextView android:id="@+id/library_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/runtime_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/add_route" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="地图建路线" />
        <Button android:id="@+id/import_library" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="导入 JSON" />
        <Button android:id="@+id/export_library" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="导出 JSON" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/pause_resume" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="暂停 / 恢复" />
        <Button android:id="@+id/stop_scene" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="停止场景" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击记录可开始、重命名、复制或修改播放模式。编辑不会改变运行中的场景。" />
    <ListView android:id="@+id/library_items" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
