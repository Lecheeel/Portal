<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/page_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Portal.Title"
            android:text="@string/ui_settings_title"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:textAppearance="@style/Portal.Body"
            android:text="@string/ui_settings_desc" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Portal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textAppearance="@style/Portal.Section"
                    android:text="@string/ui_settings_basic"
                    android:accessibilityHeading="true" />
                <LinearLayout
                    android:id="@+id/altitude_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="76dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/altitude_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/altitude"
                            android:textAppearance="@style/Portal.Section" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_keyboard_arrow_down_24"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/altitude_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="80.0米"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/altitude_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/altitude_desc"
                        android:textAppearance="@style/Portal.Body" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/accuracy_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="76dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/accuracy_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/accuracy"
                            android:textAppearance="@style/Portal.Section" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_keyboard_arrow_down_24"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accuracy_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="25.0米"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/accuracy_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/accuracy_desc"
                        android:textAppearance="@style/Portal.Body" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/report_duration_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="76dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/report_duration_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/item_report_duration_title"
                            android:textAppearance="@style/Portal.Section" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_keyboard_arrow_down_24"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/report_duration_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/item_report_duration_value"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/report_duration_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/item_report_duration_desc"
                        android:textAppearance="@style/Portal.Body" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Portal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textAppearance="@style/Portal.Section"
                    android:text="@string/ui_settings_motion"
                    android:accessibilityHeading="true" />
                <LinearLayout
                    android:id="@+id/speed_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="76dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/speed_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="@string/rocker_speed"
                            android:textAppearance="@style/Portal.Section" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_keyboard_arrow_down_24"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/speed_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3.05米/秒"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/speed_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rocker_speed_desc"
                        android:textAppearance="@style/Portal.Body" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/smooth_route_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:text="@string/smooth_route_motion"
                    app:useMaterialThemeColors="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/smooth_route_motion_desc"
                    android:textSize="13sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/orbit_motion_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:text="@string/orbit_motion_experiment"
                    app:useMaterialThemeColors="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/orbit_motion_experiment_desc"
                    android:textSize="13sp" />
                <LinearLayout
                    android:id="@+id/orbit_radius_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="76dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/orbit_radius_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="圆周运动半径"
                            android:textAppearance="@style/Portal.Section" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_keyboard_arrow_down_24"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/orbit_radius_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.20米"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/orbit_period_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/orbit_period" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/orbit_period_desc"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Portal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textAppearance="@style/Portal.Section"
                    android:text="@string/ui_settings_channels"
                    android:accessibilityHeading="true" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/gms_mock_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:text="@string/gms_mock_channel"
                    app:useMaterialThemeColors="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/gms_mock_channel_desc"
                    android:textSize="13sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/platform_fused_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:text="@string/platform_fused_channel"
                    app:useMaterialThemeColors="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/platform_fused_channel_desc"
                    android:textSize="13sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/startup_burst_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:text="@string/startup_burst"
                    app:useMaterialThemeColors="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/startup_burst_desc"
                    android:textSize="13sp" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/clear_mock_flag_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:padding="8dp"
                    android:text="@string/clear_mock_flag_experiment"
                    app:useMaterialThemeColors="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:text="@string/clear_mock_flag_experiment_desc"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Portal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textAppearance="@style/Portal.Section"
                    android:text="@string/ui_settings_hooks"
                    android:accessibilityHeading="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:textAppearance="@style/Portal.Body"
                    android:text="@string/ui_settings_hooks_desc" />
                <LinearLayout
                    android:id="@+id/selinux_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/selinux"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/need_open_selinux"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/selinux_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/debug_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/debug"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/debug_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/debug_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dgc_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dgc"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dgc_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/dgc_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/rll_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rll"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rll_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/rll_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dfused_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dfused"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dfused_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/dfused_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cdma_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cdma"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cdma_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/cdma_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/sensor_hook_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hook_sensor"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hook_sensor_desc"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sensor_hook_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/satellite_count_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:minHeight="76dp"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/satellite_count_title"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="模拟最少卫星数量"
                            android:textAppearance="@style/Portal.Section" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/baseline_keyboard_arrow_down_24"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/satellite_count_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="12颗"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/satellite_count_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="最少模拟的卫星数量（只支持北斗）"
                        android:textAppearance="@style/Portal.Body" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/disable_wlan_scan_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="禁用扫描WIFI列表"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="一定程度解决位置拉回（测试）"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/disable_wlan_scan_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/loop_broadcast_location_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="反定位拉回"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="按上报间隔持续发送固定位置，不产生随机跳动"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/loop_broadcast_location_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Portal.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:textAppearance="@style/Portal.Section"
                    android:text="@string/ui_settings_app"
                    android:accessibilityHeading="true" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/background_guidance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/background_guidance" />
                <LinearLayout
                    android:id="@+id/check_update_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/check_update_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检查更新"
                            android:textColor="@color/lse_mini_title_color" />
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/check_update_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="点击检查 GitHub Releases 最新版本"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/check_update_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>