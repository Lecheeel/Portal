<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/rocker_minimized"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/rocker_bubble"
        android:contentDescription="@string/overlay_expand"
        android:elevation="4dp"
        android:padding="13dp"
        app:srcCompat="@drawable/ic_home_rocker"
        app:tint="@color/primary" />

    <LinearLayout
        android:id="@+id/rocker_panel"
        android:layout_width="176dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rocker_panel"
        android:clipToOutline="true"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/move"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/rocker_tool"
                android:contentDescription="@string/overlay_drag"
                android:focusable="true">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/rocker_grip"
                    app:tint="@color/text_secondary" />

                <View
                    android:id="@+id/rocker_state_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/rocker_state_dot"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/auto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rocker_tool"
                android:contentDescription="@string/overlay_auto"
                android:padding="14dp"
                android:tooltipText="@string/overlay_auto"
                app:srcCompat="@drawable/baseline_robot_24"
                app:tint="@color/text_secondary" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/expand_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rocker_tool"
                android:contentDescription="@string/overlay_minimize"
                android:padding="14dp"
                android:tooltipText="@string/overlay_minimize"
                app:srcCompat="@drawable/rocker_minimize"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <com.system.location.service.android.widget.RockerView
            android:id="@+id/rocker"
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/overlay_joystick"
            app:areaBackground="@color/surface_variant"
            app:rockerBackground="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/speed_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rocker_tool"
                android:contentDescription="@string/overlay_speed_decrease"
                android:padding="15dp"
                app:srcCompat="@drawable/rocker_minimize"
                app:tint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="m/s"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/speed_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rocker_tool"
                android:contentDescription="@string/overlay_speed_increase"
                android:padding="15dp"
                app:srcCompat="@drawable/rocker_plus"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/speed_slider"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:contentDescription="@string/rocker_speed"
            android:valueFrom="0.0"
            android:valueTo="50.0"
            app:haloRadius="18dp"
            app:labelBehavior="gone"
            app:thumbColor="@color/primary"
            app:thumbRadius="7dp"
            app:tickVisible="false"
            app:trackColorActive="@color/primary"
            app:trackColorInactive="@color/surface_container_highest"
            app:trackHeight="3dp" />

        <TextView
            android:id="@+id/speed_kmh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
