<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">
    <fragment android:id="@+id/nav_runtime" android:name="com.system.location.service.ui.runtime.RuntimeFragment"
        android:label="@string/ui_runtime_title" tools:layout="@layout/fragment_runtime" />

    <fragment
        android:id="@+id/nav_home"
        android:name="com.system.location.service.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_mock"
        android:name="com.system.location.service.ui.mock.SimulationFragment"
        android:label="@string/simulation_title"
        tools:layout="@layout/fragment_simulation" />

    <!-- Compatibility destination for existing links; opens the satellite tab. -->
    <fragment
        android:id="@+id/nav_gnss_mock"
        android:name="com.system.location.service.ui.mock.SimulationFragment"
        android:label="@string/simulation_title"
        tools:layout="@layout/fragment_simulation">
        <argument android:name="initialTab" app:argType="integer" android:defaultValue="1" />
    </fragment>

    <fragment
        android:id="@+id/nav_route_gallery"
        android:name="com.system.location.service.ui.mock.RouteMockFragment"
        android:label="@string/menu_route_mock"
        tools:layout="@layout/fragment_route_mock" />

    <fragment
        android:id="@+id/nav_route_edit"
        android:name="com.system.location.service.ui.mock.RouteEditFragment"
        android:label="@string/menu_route_mock_edit"
        tools:layout="@layout/fragment_route_edit" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.system.location.service.ui.settings.SettingsFragment"
        android:label="@string/menu_setting"
        tools:layout="@layout/fragment_settings" />
</navigation>
