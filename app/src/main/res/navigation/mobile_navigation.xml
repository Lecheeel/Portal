<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">
    <fragment android:id="@+id/nav_runtime" android:name="com.system.location.service.ui.runtime.RuntimeComposeFragment"
        android:label="@string/ui_runtime_title" tools:layout="@layout/fragment_runtime" />

    <fragment
        android:id="@+id/nav_home"
        android:name="com.system.location.service.ui.home.HomeComposeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_mock"
        android:name="com.system.location.service.ui.mock.SimulationComposeFragment"
        android:label="@string/simulation_title" />

    <!-- Compatibility destination for existing links; opens the satellite tab. -->
    <fragment
        android:id="@+id/nav_gnss_mock"
        android:name="com.system.location.service.ui.mock.SimulationComposeFragment"
        android:label="@string/simulation_title">
        <argument android:name="initialTab" app:argType="integer" android:defaultValue="1" />
    </fragment>

    <fragment
        android:id="@+id/nav_route_gallery"
        android:name="com.system.location.service.ui.mock.RouteGalleryComposeFragment"
        android:label="@string/menu_route_mock"
        tools:layout="@layout/fragment_route_mock" />

    <fragment
        android:id="@+id/nav_route_edit"
        android:name="com.system.location.service.ui.mock.RouteEditComposeFragment"
        android:label="@string/menu_route_mock_edit"
        tools:layout="@layout/fragment_route_edit" />

    <fragment android:id="@+id/nav_environment"
        android:name="com.system.location.service.ui.environment.EnvironmentComposeFragment"
        android:label="@string/environment_tools_title" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="@string/menu_setting" />
    <fragment android:id="@+id/nav_settings_location"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="地图与定位">
        <argument android:name="category" app:argType="string" android:defaultValue="LOCATION" />
    </fragment>
    <fragment android:id="@+id/nav_settings_motion"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="运动与摇杆">
        <argument android:name="category" app:argType="string" android:defaultValue="MOTION" />
    </fragment>
    <fragment android:id="@+id/nav_settings_gnss"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="卫星与 GNSS">
        <argument android:name="category" app:argType="string" android:defaultValue="GNSS" />
    </fragment>
    <fragment android:id="@+id/nav_settings_apps"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="分应用规则">
        <argument android:name="category" app:argType="string" android:defaultValue="APPS" />
    </fragment>
    <fragment android:id="@+id/nav_settings_system"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="系统与环境模拟">
        <argument android:name="category" app:argType="string" android:defaultValue="SYSTEM" />
    </fragment>
    <fragment android:id="@+id/nav_settings_advanced"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="高级与实验">
        <argument android:name="category" app:argType="string" android:defaultValue="ADVANCED" />
    </fragment>
    <fragment android:id="@+id/nav_settings_privacy"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="后台与隐私">
        <argument android:name="category" app:argType="string" android:defaultValue="PRIVACY" />
    </fragment>
    <fragment android:id="@+id/nav_settings_updates"
        android:name="com.system.location.service.ui.settings.SettingsComposeFragment"
        android:label="关于与更新">
        <argument android:name="category" app:argType="string" android:defaultValue="UPDATES" />
    </fragment>
</navigation>





