<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="sdk_privacy.xml" />
        <!-- Installation identity, queued reports and SDK state must not migrate. -->
        <exclude domain="database" path="bugly_db_" />
        <exclude domain="sharedpref" path="crashrecord.xml" />
        <exclude domain="sharedpref" path="BuglySdkInfos.xml" />
        <exclude domain="sharedpref" path="BUGLY_COMMON_VALUES.xml" />
        <exclude domain="sharedpref" path="BUGLY_RESERVED_VALUES.xml" />
        <exclude domain="root" path="app_bugly" />
        <exclude domain="root" path="app_crashrecord" />
    <exclude domain="sharedpref" path="scenario_runtime.xml" />
    <exclude domain="sharedpref" path="mock_provider_ownership.xml" />
    <exclude domain="sharedpref" path="gms_mock_ownership.xml" />
    <!-- Captured WiFi/cell/BLE snapshots are sensitive and must not leave the device. -->
    <exclude domain="file" path="environment/" />
    <exclude domain="sharedpref" path="fused_ext.xml" />
    <exclude domain="file" path="library/" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
