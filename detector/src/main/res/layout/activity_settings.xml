<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/detector_primary"
        android:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_target_package"
                android:textColor="@color/detector_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/targetPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_target_package_hint"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_sample_seconds"
                android:textColor="@color/detector_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/sampleSeconds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />

            <Switch
                android:id="@+id/testGms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_test_gms"
                android:textColor="@color/detector_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_test_gms_desc"
                android:textColor="@color/detector_text_secondary"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/checkNetworkIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_check_network_ip"
                android:textColor="@color/detector_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_check_network_ip_desc"
                android:textColor="@color/detector_text_secondary"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/readInstalledApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/settings_read_apps"
                android:textColor="@color/detector_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_read_apps_desc"
                android:textColor="@color/detector_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_save"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
